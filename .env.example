# ApplyPilot configuration — GENERATED from src/applypilot/settings.py.
# Edit that file and run `applypilot doctor --write-env-example`, not this one.
#
# Every value below is the default; uncomment only what you change.

# ── llm ─────────────────────────────────────────────────────────
# Provider failover order, comma-separated.
#LLM_PROVIDER_ORDER=
# Override the model for the active provider.
#LLM_MODEL=
# Base URL for a local/self-hosted model.
#LLM_URL=
# Generic LLM key (fallback).
#LLM_API_KEY=
# OpenAI key.
#OPENAI_API_KEY=
# Gemini key.
#GEMINI_API_KEY=
# Anthropic key.
#ANTHROPIC_API_KEY=
# Alias for ANTHROPIC_API_KEY.
#CLAUDE_API_KEY=

# ── followup ────────────────────────────────────────────────────
# Hours after the previous message that each email follow-up comes due.
#FOLLOWUP_SCHEDULE=48,96,168
# Same, for LinkedIn. Slower on purpose — nudging a new connection reads badly.
#LINKEDIN_FOLLOWUP_SCHEDULE=120,288
# Same, for iMessage/SMS. Slowest of the three — a text arrives on a lock screen.
#SMS_FOLLOWUP_SCHEDULE=72,168
# Silence after the FIRST email before texting and calling opens, even though the email ladder is still running. 168 = a week.
#REACH_AFTER_HOURS=168
# Same, for phone calls. ONE more, 3 days later — a third unanswered call is not persistence, it is how a number gets blocked.
#CALL_FOLLOWUP_SCHEDULE=72
# How late a SCHEDULED follow-up may still fire on its own. Nothing runs while the dashboard is closed, so a send promised at 09:00 on a shut laptop is late rather than cancelled — inside this window it goes when the dashboard is next opened, past it the card reads 'missed' and waits for you.
#SCHEDULED_SEND_GRACE_HOURS=24
# DEPRECATED — derived from the first entry of FOLLOWUP_SCHEDULE.  [DEPRECATED]
#FOLLOWUP_AFTER_DAYS=
# Hours of silence from THEM before a live conversation counts as stalled. Shorter than any cold ladder on purpose: somebody who replied has earned a faster, lighter nudge than a stranger.
#STALLED_AFTER_HOURS=72

# ── outreach ────────────────────────────────────────────────────
# Max emails sent per 24h.
#OUTREACH_DAILY_LIMIT=20
# Don't email the same address again within this many days.
#OUTREACH_COOLDOWN_DAYS=30
# Total emails ONE employer may receive — first contacts plus follow-ups, across every job. 0 disables. The daily limit is global and the cooldown is per address, so neither stops 7 people at one company getting 3 touches each.
#OUTREACH_COMPANY_CAP=8
# Comma-separated places whose people are never kept by contact discovery. Applied as Apollo's own `person_not_locations` so an excluded person is never enriched and never costs a credit, plus a second check on the enriched location. Empty disables it. Filters at DISCOVERY — it never deletes or alters a stored contact.
#OUTREACH_EXCLUDE_LOCATIONS=India
# Display name on outgoing mail.
#OUTREACH_FROM_NAME=
# From address (defaults to the connected Gmail).
#OUTREACH_FROM_ADDRESS=
# Signature HTML; falls back to the Gmail one.
#OUTREACH_SIGNATURE=
# Extra style guidance for drafts.
#OUTREACH_STYLE=
# Attach résumé + cover letter to the first email.
#OUTREACH_ATTACH_DOCS=1
# Intro-deck link offered in every outreach email (not LinkedIn notes).
#INTRO_DECK_URL=https://www.jorgealejandrodiez.com/intro/
# Personalise the deck link per contact (/intro/gina instead of /intro/). OFF until the site actually serves those paths and the click collector is live — a link that 404s costs the conversation.
#INTRO_DECK_PATHS=0
# Calendar link for the call-to-action.
#SCHEDULING_LINK=
# Endpoint that returns recorded intro-deck clicks (see deploy/netlify/).
#DECK_HITS_URL=
# Bearer token for DECK_HITS_URL.
#DECK_HITS_TOKEN=
# SMTP fallback address.
#GMAIL_ADDRESS=
# SMTP app password.
#GMAIL_APP_PASSWORD=
# Comma-separated. Other email addresses that are YOU — a résumé address, an alias, an old account. Mail from these is your own, not theirs. Without them your own messages are stored as inbound and the CRM thinks the other side replied.
#MY_ADDRESSES=

# ── networking ──────────────────────────────────────────────────
# Minimum colleagues (people doing the job) to find per job.
#OUTREACH_MIN_PEERS=4
# Minimum recruiters / talent contacts to find per job.
#OUTREACH_MIN_RECRUITERS=4
# Apollo.io key (paid plan).
#APOLLO_API_KEY=
# Enable read-only LinkedIn augmentation.
#NETWORKING_LINKEDIN=0
# Enable LinkedIn DM composing.
#NETWORKING_LINKEDIN_DM=0
# Max LinkedIn actions per day.
#NETWORKING_LINKEDIN_DAILY_LIMIT=20
# Max LinkedIn DMs per day.
#LINKEDIN_DM_DAILY_LIMIT=15
# Don't DM the same person within this many days.
#LINKEDIN_DM_COOLDOWN_DAYS=30
# LinkedIn session cookie.
#LINKEDIN_DM_SESSION=
# Chrome binary for the DM helper.
#LINKEDIN_DM_CHROME_EXEC=
# Chrome profile dir for the DM helper.
#LINKEDIN_DM_CHROME_PROFILE=

# ── apply ───────────────────────────────────────────────────────
# Release an in-progress apply lock after this long (an interrupted run).
#APPLY_STALE_MINUTES=30
# Seconds the apply agent gets per application before it is given up on.
#APPLY_AGENT_TIMEOUT=900
# How many jobs are tailored and written at once. Measured: a tailored résumé is ~25s per attempt and up to four attempts, so this is where prepare's wall clock goes. Purely network-bound waiting on the model — it costs no more tokens, only less waiting.
#PREPARE_WORKERS=3
# How many applications the dashboard fills at once. Each worker gets its own Chrome window, CDP port and profile, so each finished form waits for you independently — the agent still never submits. Raising this raises how many filled forms sit open at the same time, not how much gets sent.
#APPLY_WORKERS=3
# Mirror the job description closely and skip the fabrication judge.
#TAILOR_AGGRESSIVE=0
# Let the apply agent complete CONTRACT and hourly postings, not only salaried roles. Marketplace signup, profile builders and assessment platforms are still refused, and no safety rule changes.
#APPLY_ALLOW_CONTRACT=0
# Chrome binary for the apply agent.
#CHROME_PATH=
# Node binary for the résumé renderer.
#NODE_BIN=
# agent-browser binary.
#AGENT_BROWSER_BIN=
# CAPTCHA solver key.
#CAPSOLVER_API_KEY=

# ── paths ───────────────────────────────────────────────────────
# Override the data directory (~/.applypilot).
#APPLYPILOT_DIR=
