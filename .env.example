# ApplyPilot configuration — GENERATED from src/applypilot/settings.py.
# Edit that file and run `applypilot doctor --write-env-example`, not this one.
#
# Every value below is the default; uncomment only what you change.

# ── llm ─────────────────────────────────────────────────────────
# Provider failover order, comma-separated.
#LLM_PROVIDER_ORDER=
# Override the model for the active provider.
#LLM_MODEL=
# Base URL for a local/self-hosted model.
#LLM_URL=
# Generic LLM key (fallback).
#LLM_API_KEY=
# OpenAI key.
#OPENAI_API_KEY=
# Gemini key.
#GEMINI_API_KEY=
# Anthropic key.
#ANTHROPIC_API_KEY=
# Alias for ANTHROPIC_API_KEY.
#CLAUDE_API_KEY=

# ── followup ────────────────────────────────────────────────────
# Hours after the previous message that each email follow-up comes due.
#FOLLOWUP_SCHEDULE=48,96,168
# Same, for LinkedIn. Slower on purpose — nudging a new connection reads badly.
#LINKEDIN_FOLLOWUP_SCHEDULE=120,288
# DEPRECATED — derived from the first entry of FOLLOWUP_SCHEDULE.  [DEPRECATED]
#FOLLOWUP_AFTER_DAYS=

# ── outreach ────────────────────────────────────────────────────
# Max emails sent per 24h.
#OUTREACH_DAILY_LIMIT=20
# Don't email the same address again within this many days.
#OUTREACH_COOLDOWN_DAYS=30
# Display name on outgoing mail.
#OUTREACH_FROM_NAME=
# From address (defaults to the connected Gmail).
#OUTREACH_FROM_ADDRESS=
# Signature HTML; falls back to the Gmail one.
#OUTREACH_SIGNATURE=
# Extra style guidance for drafts.
#OUTREACH_STYLE=
# Attach résumé + cover letter to the first email.
#OUTREACH_ATTACH_DOCS=1
# Also attach the intro deck.
#OUTREACH_ATTACH_DECK=0
# Path to the intro deck PDF.
#INTRO_DECK_PATH=
# Intro-deck link offered in every outreach email (not LinkedIn notes).
#INTRO_DECK_URL=https://www.jorgealejandrodiez.com/intro/
# Calendar link for the call-to-action.
#SCHEDULING_LINK=
# Endpoint that returns recorded intro-deck clicks (see deploy/netlify/).
#DECK_HITS_URL=
# Bearer token for DECK_HITS_URL.
#DECK_HITS_TOKEN=
# SMTP fallback address.
#GMAIL_ADDRESS=
# SMTP app password.
#GMAIL_APP_PASSWORD=

# ── networking ──────────────────────────────────────────────────
# Apollo.io key (paid plan).
#APOLLO_API_KEY=
# Enable read-only LinkedIn augmentation.
#NETWORKING_LINKEDIN=0
# Enable LinkedIn DM composing.
#NETWORKING_LINKEDIN_DM=0
# Max LinkedIn actions per day.
#NETWORKING_LINKEDIN_DAILY_LIMIT=20
# Max LinkedIn DMs per day.
#LINKEDIN_DM_DAILY_LIMIT=15
# Don't DM the same person within this many days.
#LINKEDIN_DM_COOLDOWN_DAYS=30
# LinkedIn session cookie.
#LINKEDIN_DM_SESSION=
# Chrome binary for the DM helper.
#LINKEDIN_DM_CHROME_EXEC=
# Chrome profile dir for the DM helper.
#LINKEDIN_DM_CHROME_PROFILE=

# ── apply ───────────────────────────────────────────────────────
# Release an in-progress apply lock after this long (an interrupted run).
#APPLY_STALE_MINUTES=30
# Seconds the apply agent gets per application before it is given up on.
#APPLY_AGENT_TIMEOUT=900
# Mirror the job description closely and skip the fabrication judge.
#TAILOR_AGGRESSIVE=0
# Chrome binary for the apply agent.
#CHROME_PATH=
# Node binary for the résumé renderer.
#NODE_BIN=
# agent-browser binary.
#AGENT_BROWSER_BIN=
# CAPTCHA solver key.
#CAPSOLVER_API_KEY=

# ── paths ───────────────────────────────────────────────────────
# Override the data directory (~/.applypilot).
#APPLYPILOT_DIR=
