# User data (NEVER commit)
# OAuth tokens. They live in ~/.applypilot/ today, so nothing here is at risk RIGHT NOW — but
# ID-1 lets an operator name a `token_path` per identity, and a relative one resolves against
# the repo root, because the Dev workflow starts the dashboard from there. This repo is a PUBLIC
# fork that cannot be made private, and a push cannot be un-published.
*token*.json
tokens/
credentials*.json
profile.json
resume.txt
resume.pdf
*Resume.pdf
*Resume.txt
*.env
.env.*
!.env.example

# Runtime artifacts
*.db
tailored_resumes/
cover_letters/
chrome-workers/
apply-workers/
apply_logs/
logs/

# MCP configs (per-machine)
.mcp*.json

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Claude Code
.claude/

# ARCH-2: dev-only ESLint toolchain for src/applypilot/static (never shipped)
node_modules/
package-lock.json
